{
  "$description": "Waypost design tokens ('Coral & Graphite'). The single source of truth for colours, type, radii, shadows and motion. Run `pnpm tokens` after editing; it regenerates packages/ui/src/tokens.css and theme.css. Values are explained in docs/03-design-system.md. References like {ink.100} point into `palette`.",
  "palette": {
    "ink": {
      "950": "#0E1116",
      "900": "#161A21",
      "800": "#1F242D",
      "700": "#2B313C",
      "600": "#3B4250",
      "500": "#5A6372",
      "400": "#8A93A3",
      "300": "#B7BEC9",
      "200": "#D9DDE4",
      "100": "#ECEFF3",
      "50": "#F6F7F9"
    },
    "white": "#FFFFFF",
    "coral": { "100": "#FFE3E0", "400": "#FF7B71", "500": "#FF5A4E", "600": "#D13A30", "700": "#B9322A" },
    "lagoon": { "500": "#13B8A6", "600": "#0E8F81", "700": "#0B7568" },
    "marigold": "#FFB020",
    "iris": "#6E6BFF",
    "success": "#2BB673",
    "warning": "#FFB020",
    "danger": "#F0443A",
    "info": "#3B82F6"
  },
  "theme": {
    "light": {
      "app": "{ink.100}",
      "panel": "{white}",
      "raised": "{ink.50}",
      "line": "{ink.200}",
      "line-strong": "{ink.300}",
      "fg": "{ink.950}",
      "fg-muted": "{ink.500}",
      "fg-disabled": "{ink.300}",
      "pin": "{coral.600}",
      "on-pin": "{white}",
      "pin-tint": "{coral.100}",
      "pin-line": "#F2A59E",
      "primary": "{coral.600}",
      "primary-hover": "{coral.700}",
      "on-primary": "{white}",
      "sel": "{lagoon.600}",
      "sel-strong": "{lagoon.700}",
      "sel-tint": "rgba(14, 143, 129, 0.12)",
      "danger": "#B4261C",
      "danger-tint": "rgba(180, 38, 28, 0.08)",
      "snap": "{marigold}",
      "switch-off": "{ink.400}",
      "clip": "#DDE3EB",
      "clip-line": "#AEB7C4",
      "voice": "#E7E6FF",
      "voice-line": "#7B78F0",
      "music": "#FFF1D6",
      "music-line": "#D99A16",
      "hatch": "rgba(90, 99, 114, 0.16)",
      "scrim": "rgba(14, 17, 22, 0.5)",
      "glass": "rgba(255, 255, 255, 0.86)",
      "inverse": "{ink.950}",
      "on-inverse": "{white}",
      "shadow-panel": "0 1px 2px rgba(14, 17, 22, 0.05), 0 6px 20px rgba(14, 17, 22, 0.06)",
      "shadow-pop": "0 18px 60px rgba(14, 17, 22, 0.22)"
    },
    "dark": {
      "app": "{ink.950}",
      "panel": "{ink.900}",
      "raised": "{ink.800}",
      "line": "{ink.700}",
      "line-strong": "{ink.600}",
      "fg": "{ink.100}",
      "fg-muted": "{ink.400}",
      "fg-disabled": "{ink.600}",
      "pin": "{coral.500}",
      "on-pin": "{ink.950}",
      "pin-tint": "rgba(255, 90, 78, 0.14)",
      "pin-line": "rgba(255, 90, 78, 0.45)",
      "primary": "{coral.600}",
      "primary-hover": "{coral.700}",
      "on-primary": "{white}",
      "sel": "{lagoon.500}",
      "sel-strong": "#3FD1C0",
      "sel-tint": "rgba(19, 184, 166, 0.16)",
      "danger": "{coral.400}",
      "danger-tint": "rgba(255, 123, 113, 0.12)",
      "snap": "{marigold}",
      "switch-off": "#6B7484",
      "clip": "#283040",
      "clip-line": "#46505F",
      "voice": "rgba(110, 107, 255, 0.2)",
      "voice-line": "#8F8CFF",
      "music": "rgba(255, 176, 32, 0.14)",
      "music-line": "#E5A11F",
      "hatch": "rgba(138, 147, 163, 0.18)",
      "scrim": "rgba(5, 7, 10, 0.66)",
      "glass": "rgba(22, 26, 33, 0.86)",
      "inverse": "{ink.100}",
      "on-inverse": "{ink.950}",
      "shadow-panel": "0 1px 2px rgba(0, 0, 0, 0.3)",
      "shadow-pop": "0 18px 60px rgba(0, 0, 0, 0.55)"
    }
  },
  "annotation": {
    "coral": "{coral.500}",
    "marigold": "{marigold}",
    "lagoon": "{lagoon.500}",
    "iris": "{iris}",
    "snow": "{white}",
    "ink": "{ink.950}"
  },
  "font": {
    "ui": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif",
    "brand": "\"Figtree\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
  },
  "text": { "xs": "11px", "sm": "12px", "base": "13px", "md": "15px", "lg": "18px", "xl": "22px", "2xl": "28px" },
  "radius": { "sm": "6px", "md": "10px", "lg": "14px", "pill": "999px" },
  "motion": {
    "ui": "160ms",
    "zoom": "450ms",
    "ease-out": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)"
  }
}
